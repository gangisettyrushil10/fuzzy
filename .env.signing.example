# Copy to .env.signing and fill in. Never commit .env.signing.

# --- Code signing (Developer ID Application, not Mac App Store) ---
# Export from Keychain Access: Developer ID Application cert -> .p12
CSC_LINK=/path/to/DeveloperID_Application.p12
CSC_KEY_PASSWORD=

# Alternative: cert already in Keychain (skip CSC_LINK)
# CSC_NAME=Developer ID Application: Humyn LLC (XXXXXXXXXX)

# --- Notarization (pick ONE method) ---

# Option A: App Store Connect API key (preferred for repeat builds / CI)
# Create at appstoreconnect.apple.com -> Users and Access -> Integrations -> Keys
APPLE_API_KEY=/path/to/AuthKey_XXXXXXXXXX.p8
APPLE_API_KEY_ID=
APPLE_API_KEY_ISSUER=

# Option B: Apple ID + app-specific password
# Create password at appleid.apple.com -> Sign-In and Security
# APPLE_ID=you@example.com
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
# APPLE_TEAM_ID=XXXXXXXXXX
