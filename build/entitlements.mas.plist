<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Sandbox required for Mac App Store -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Outbound network for OpenAI API calls -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- User-selected files read/write (PDF/EPUB import via open panel) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Downloads folder read (optional convenience for import) -->
    <key>com.apple.security.files.downloads.read-only</key>
    <true/>

    <!-- Native Spotify playback through its declared Apple Events access groups -->
    <key>com.apple.security.scripting-targets</key>
    <dict>
      <key>com.spotify.client</key>
      <array>
        <string>com.spotify.playback</string>
        <string>com.spotify.library</string>
      </array>
    </dict>

    <!-- Electron / V8 JIT — required for Electron + HuggingFace WASM -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
